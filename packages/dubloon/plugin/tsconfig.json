{
  "extends": "expo-module-scripts/tsconfig.plugin",
  "compilerOptions": {
    "outDir": "build",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "typeRoots": ["./ts-declarations", "../../../node_modules/@types"]
  },
  "include": ["./src"],
  "exclude": ["**/__mocks__/*", "**/*.test.ts"]
}
